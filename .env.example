# Application
APP_ENV=development
PROJECT_NAME=RAG PDF Backend
API_V1_STR=/api/v1
DEBUG=true
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://frontend:3000","http://localhost:3001","http://127.0.0.1:3000"]

# PostgreSQL and pgvector
POSTGRES_DB=ragpdf
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/ragpdf
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Google Gemini
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash # can change to newest model if available
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=4096

# Vector store
VECTOR_COLLECTION=documents
VECTOR_TOP_K=5
VECTOR_DISTANCE=cosine

# RAG and file uploads
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=[".pdf",".docx",".txt",".md",".csv"]

# Redis
REDIS_URL=redis://redis:6379/0
CACHE_TTL=3600

# Logging
LOG_LEVEL=INFO

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
